{
  "installCommand": "npm install",
  "buildCommand": "node scripts/build-xtoytouch.mjs && npx vite build --config vite.config.vercel.ts",
  "outputDirectory": "dist",
  "ignoreCommand": "node scripts/ignore-vercel-build.js",
  "headers": [
    {
      "source": "/xtoytouch/XtoyTouch.user.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=60, stale-while-revalidate=300"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"XtoyTouch.user.js\""
        }
      ]
    },
    {
      "source": "/xtoytouch/XtoyTouch.meta.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=60, stale-while-revalidate=300"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/reportar-bugs",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/downloads/:file(XTOYBOX-v[0-9.]+\\.apk)",
      "destination": "https://github.com/jmita2288-debug/xtoybox-apk-download/releases/download/xtoybox-latest/:file",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
